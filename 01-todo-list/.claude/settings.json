{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq . >> ~/.claude/logs/bash-command-log.txt"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "WebFetch"
    ]
  }
}
